// ETeaching Platform — data model
//
// Defaults to SQLite (zero-setup local dev + single-server deploy).
// To go live on a managed database, switch `provider` to "postgresql" (or
// "mysql") and update DATABASE_URL, then run `npm run db:push`. The rest of
// the schema is dialect-portable on purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A class (班级). A single teacher manages all classes; students each join one.
model Class {
  id        String   @id @default(cuid())
  name      String   @unique // 班级号 / 名称
  createdAt DateTime @default(now())

  students    User[]
  assignments Assignment[]
}

// A user is either a TEACHER (pre-registered by the administrator) or a
// STUDENT (self-registered). Students belong to one class; teachers have none.
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("STUDENT") // "TEACHER" | "STUDENT"
  classId      String?
  class        Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  sessions          Session[]
  createdAssignments Assignment[]     @relation("AssignmentCreator")
  assignmentLinks   AssignmentStudent[]
  submissions       Submission[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A homework assignment published by a teacher, scoped to one class.
// `images` / `attachments` store JSON arrays (of base64 data-URL strings) in a
// text column so no external file/blob service is required.
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  images      String   @default("[]")
  startAt     DateTime
  dueAt       DateTime
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    AssignmentStudent[]
  submissions Submission[]
}

// Which students are required to submit a given assignment (teacher-selected
// from within the assignment's class, with select-all support in the UI).
model AssignmentStudent {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// A student's submission for one assignment.
// `score` starts at 0; only teachers may edit it. `graded` marks that a teacher
// has actually set a score (vs. the untouched default 0).
model Submission {
  id             String    @id @default(cuid())
  assignmentId   String
  studentId      String
  remark         String    @default("") // 学生备注（可选）
  images         String    @default("[]") // JSON array of base64 photo data URLs
  feedback       String    @default("") // 教师评语（文字）
  feedbackImages String    @default("[]") // 教师评语配图
  annotations    String    @default("[]") // 每张照片的涂鸦批改（PNG overlay，索引对应 images）
  submittedAt    DateTime
  updatedAt      DateTime  @updatedAt
  score          Float     @default(0)
  graded         Boolean   @default(false)
  gradedById     String?
  gradedAt       DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}
